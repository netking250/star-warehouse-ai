{
  "id": null,
  "uid": "t17-platform-health",
  "title": "Platform / API Health",
  "tags": ["star-warehouse-ai", "t17", "api"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Application request rate",
      "type": "timeseries",
      "description": "Requests per second by normalized route status class.",
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {"refId": "A", "expr": "sum by (status_class) (rate(http_requests_total[5m]))", "legendFormat": "{{status_class}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 2}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "HTTP 5xx error rate",
      "type": "stat",
      "description": "Share of application requests returning a server error; empty traffic is shown as no data.",
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {"refId": "A", "expr": "sum(rate(http_errors_total{error_category=\"server_error\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 0.001)", "legendFormat": "5xx"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "decimals": 3, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.01}, {"color": "red", "value": 0.05}]}}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0}
    },
    {
      "id": 3,
      "title": "HTTP p95 latency",
      "type": "timeseries",
      "description": "95th percentile duration across normalized application routes.",
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 3}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}
    },
    {
      "id": 4,
      "title": "Requests in flight",
      "type": "stat",
      "description": "Current application requests being processed.",
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [{"refId": "A", "expr": "http_requests_in_flight", "legendFormat": "in flight"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 8}
    },
    {
      "id": 5,
      "title": "Dependency health",
      "type": "table",
      "description": "One means the last application health check succeeded; zero means unavailable.",
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [{"refId": "A", "expr": "app_dependency_health", "legendFormat": "{{component}}", "instant": true, "format": "table"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 8, "w": 18, "x": 6, "y": 8}
    },
    {
      "id": 6,
      "title": "Request rate by route",
      "type": "timeseries",
      "description": "Low-cardinality route templates for locating a failing subsystem.",
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [{"refId": "A", "expr": "sum by (route, status_class) (rate(http_requests_total[5m]))", "legendFormat": "{{route}} {{status_class}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 2}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16}
    },
    {
      "id": 7,
      "title": "Database query p95",
      "type": "timeseries",
      "description": "Aggregate database statement latency by engine role and SQL verb; statement text is not retained.",
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, engine, operation) (rate(db_query_duration_seconds_bucket[5m])))", "legendFormat": "{{engine}} {{operation}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 3}, "overrides": []},
      "gridPos": {"h": 8, "w": 16, "x": 0, "y": 24}
    },
    {
      "id": 8,
      "title": "Database connections in use",
      "type": "timeseries",
      "description": "Checked-out connections by application engine role.",
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [{"refId": "A", "expr": "db_connections_in_use", "legendFormat": "{{engine}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 24}
    }
  ]
}
