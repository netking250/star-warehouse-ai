{
  "realm": "star-warehouse",
  "enabled": true,
  "displayName": "Star Warehouse AI DEV-ONLY",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "clients": [
    {
      "clientId": "star-warehouse-ai",
      "name": "Star Warehouse AI DEV-ONLY OIDC Client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_DEMO_CLIENT_SECRET}",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:8000/api/v1/oidc/callback"],
      "webOrigins": ["http://localhost:8000", "http://localhost:5173"],
      "attributes": {"pkce.code.challenge.method": "S256"},
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "basic", "email"]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "oidc-demo",
      "enabled": true,
      "email": "keycloak-demo@example.com",
      "emailVerified": true,
      "firstName": "OIDC",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
