{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["image", "secretRef", "api", "worker", "scheduler", "outboxRelay", "service", "ingress"],
  "properties": {
    "productionMode": {"type": "boolean"},
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy", "allowMutableTag"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "allowMutableTag": {"type": "boolean"},
        "pullSecrets": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "buildRevision": {"type": "string", "maxLength": 64}
      }
    },
    "secretRef": {
      "type": "object",
      "required": ["name"],
      "properties": {"name": {"type": "string", "minLength": 1}}
    },
    "api": {"$ref": "#/$defs/workload"},
    "worker": {"$ref": "#/$defs/workload"},
    "maintenanceWorker": {"$ref": "#/$defs/workload"},
    "scheduler": {"$ref": "#/$defs/workload"},
    "outboxRelay": {"$ref": "#/$defs/workload"},
    "service": {
      "type": "object",
      "required": ["type", "port", "targetPort"],
      "properties": {
        "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "targetPort": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "host", "paths", "tls"],
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string", "minLength": 1},
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "pathType"],
            "properties": {
              "path": {"type": "string", "pattern": "^/"},
              "pathType": {"enum": ["Exact", "Prefix"]}
            }
          }
        },
        "tls": {
          "type": "object",
          "required": ["enabled", "secretName"],
          "properties": {
            "enabled": {"type": "boolean"},
            "secretName": {"type": "string"}
          }
        }
      }
    },
    "demoInfrastructure": {
      "type": "object",
      "required": ["enabled", "secretRefName"],
      "properties": {
        "enabled": {"type": "boolean"},
        "secretRefName": {"type": "string"},
        "storageClassName": {"type": "string"}
      }
    }
  },
  "$defs": {
    "workload": {
      "type": "object",
      "required": ["replicas", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicas": {"type": "integer", "minimum": 1},
        "resources": {"type": "object"}
      }
    }
  }
}
