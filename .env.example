# Project
PROJECT_NAME=星仓 AI 智能客服
SERVICE_NAME=star-warehouse-ai
ALERT_DEDUP_PREFIX=star-warehouse-ai
ENVIRONMENT=development
LOCAL_BOOTSTRAP_TENANT_ID=default
OIDC_ENABLED=False
OIDC_PROVIDER_NAME=keycloak-demo
OIDC_ISSUER=http://localhost:8081/realms/star-warehouse
OIDC_CLIENT_ID=star-warehouse-ai
OIDC_CLIENT_SECRET=dev-only-change-me-oidc-client
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/oidc/callback
OIDC_ALLOWED_ALGORITHMS=["RS256"]
# Disabled by default. If enabled, first-link still requires one active local user and verified email.
OIDC_LINK_VERIFIED_EMAIL=False
OIDC_STATE_TTL_SECONDS=300
OIDC_METADATA_CACHE_SECONDS=3600
OIDC_CLOCK_SKEW_SECONDS=30
OIDC_TIMEOUT_SECONDS=5
# DEV-ONLY for the local Keycloak profile; production OIDC requires HTTPS.
OIDC_ALLOW_INSECURE_HTTP=False
# Compose-only DEV credentials; replace them even on a shared development host.
KEYCLOAK_DEMO_ADMIN=dev-admin
KEYCLOAK_DEMO_ADMIN_PASSWORD=dev-only-change-me-admin
KEYCLOAK_DEMO_CLIENT_SECRET=dev-only-change-me-oidc-client
KEYCLOAK_DEMO_USER_PASSWORD=dev-only-change-me-user
BUSINESS_ADAPTER_MODE=local
BUSINESS_API_BASE_URL=
BUSINESS_API_TOKEN=
BUSINESS_API_ALLOW_INSECURE_HTTP=false
BUSINESS_API_TIMEOUT_SECONDS=5
BUSINESS_API_MAX_RETRIES=2
BUSINESS_API_CIRCUIT_FAILURE_THRESHOLD=5
BUSINESS_API_CIRCUIT_RECOVERY_SECONDS=30
API_V1_STR=/api/v1

# Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_migration_password_here
POSTGRES_DB=knowledge_base
POSTGRES_RUNTIME_USER=star_warehouse_app
POSTGRES_RUNTIME_PASSWORD=your_runtime_password_here
POSTGRES_MAINTENANCE_USER=star_warehouse_ops
POSTGRES_MAINTENANCE_PASSWORD=your_maintenance_password_here
DB_CAPABILITY=runtime

# Database connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=15
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT=5000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Database 0 is for local development. Tests force DB 15 before app imports.
REDIS_DB=0
# Redis (应用必填) - 本地开发时 docker-compose 默认使用 devpassword
REDIS_PASSWORD=devpassword
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5.0
REDIS_SOCKET_CONNECT_TIMEOUT=5.0
REDIS_HEALTH_CHECK_INTERVAL=30
REDIS_RETRY_ON_TIMEOUT=True
REDIS_SOCKET_KEEPALIVE=True
REDIS_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
REDIS_CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30
REDIS_CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=3

# Cache and shadow-test controls (optional)
CACHE_TTL_INTENT=3600
INTENT_CACHE_VERSION=v3.1
CACHE_TTL_PROFILE=300
CACHE_TTL_RETRIEVAL=600
CACHE_TTL_DB_CONFIG=300
SHADOW_TESTING_ENABLED=False
SHADOW_SAMPLE_RATE=0.1

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=knowledge_chunks
QDRANT_TIMEOUT=10
QDRANT_RETRIES=3

# Dynamic Model Gateway providers (server-side operator configuration only)
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
DASHSCOPE_API_KEY=your-dashscope-api-key
MODEL_OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
MODEL_GATEWAY_DEFAULT_TIMEOUT_SECONDS=30
# Restart-on-change route configuration. Each route is an ordered candidate list; T13 invokes only
# one explicitly selected candidate and never automatically falls back to the next candidate.
# MODEL_ROUTES={"default_chat":{"candidates":[{"provider":"openai","model":"gpt-4o-mini","capabilities":["chat","streaming","tools","structured_output"],"timeout_seconds":30},{"provider":"dashscope","model":"qwen-plus","capabilities":["chat","streaming","tools","structured_output"],"timeout_seconds":30}]}}
# Real-provider tests remain skipped unless this explicit paid-network opt-in is enabled.
RUN_REAL_LLM_TESTS=false
REAL_LLM_TEST_ROUTE=default_chat

# LLM 模型配置（可选，不填时使用默认值）
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# Reranker / Rewriter（可选，不填时使用默认值）
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
RERANK_MODEL=qwen3-rerank
REWRITE_MODEL=qwen-turbo
RERANK_TIMEOUT=10.0
REWRITE_TIMEOUT=5.0
REWRITE_CACHE_TTL_SECONDS=3600

# fastembed（可选，不填时使用默认值）
FASTEMBED_CACHE_PATH=

# LangSmith / LangChain tracing
# 启用后，所有 LangChain LLM 调用（ainvoke、with_structured_output、bind_tools、
# LangGraph 节点等）都会被自动追踪并发送到 LangSmith 平台。
#
# 快速开始：
# 1. 在 https://smith.langchain.com 注册并获取 API Key
# 2. 设置 LANGCHAIN_TRACING_V2=true
# 3. 设置 LANGSMITH_API_KEY=your-api-key
# 4. 可选：设置 LANGSMITH_PROJECT 来区分不同环境/项目
#
# 环境变量说明：
# LANGCHAIN_TRACING_V2: 是否启用 v2 追踪协议（推荐 true）
# LANGSMITH_API_KEY: LangSmith API Key（lsv2_pt_ 开头）
# LANGSMITH_PROJECT: 项目名，用于在 LangSmith 仪表板中分组
# LANGSMITH_OTEL_ENABLED: 是否同时导出到 OpenTelemetry（默认 false）
# LANGSMITH_CELERY_TRACING: 是否在 Celery worker 中也启用追踪（默认 true）
LANGCHAIN_TRACING_V2=False
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=star-warehouse-ai
LANGSMITH_OTEL_ENABLED=False
LANGSMITH_CELERY_TRACING=true

# Retriever（可选，不填时使用默认值）
RETRIEVER_DENSE_TOPK=15
RETRIEVER_SPARSE_TOPK=15
RETRIEVER_RRF_K=60
RETRIEVER_FINAL_TOPK=5
RETRIEVER_MULTI_QUERY=False
RETRIEVER_MULTI_QUERY_N=3

# Confidence（可选，不填时使用默认值）
CONFIDENCE__THRESHOLD=0.7
CONFIDENCE__HIGH_THRESHOLD=0.8
CONFIDENCE__MEDIUM_THRESHOLD=0.5
CONFIDENCE__LOW_THRESHOLD=0.3
CONFIDENCE__RAG_WEIGHT=0.3
CONFIDENCE__LLM_WEIGHT=0.5
CONFIDENCE__EMOTION_WEIGHT=0.2
CONFIDENCE__CALCULATION_TIMEOUT_SECONDS=3.0
CONFIDENCE__EMOTION_HISTORY_ROUNDS=3
CONFIDENCE__LLM_PARSE_MAX_RETRIES=3
CONFIDENCE__LLM_PARSE_RETRY_DELAY=0.5
CONFIDENCE__EVALUATION_MODEL=qwen-turbo
CONFIDENCE__ENABLE_CACHE=True
CONFIDENCE__CACHE_TTL_SECONDS=3600
CONFIDENCE__SKIP_LLM_ON_CLEAR_RAG=True
CONFIDENCE__CLEAR_RAG_THRESHOLD_HIGH=0.9
CONFIDENCE__CLEAR_RAG_THRESHOLD_LOW=0.3

# Celery
# RabbitMQ is the Celery broker. URL-encode special characters in credentials.
RABBITMQ_USER=star_warehouse_ai
RABBITMQ_PASSWORD=dev-rabbitmq-password
CELERY_BROKER_URL=amqp://star_warehouse_ai:dev-rabbitmq-password@localhost:5672//
# Redis may remain the result backend; it is not the task broker.
CELERY_RESULT_BACKEND=redis://:devpassword@localhost:6379/0

# Transactional outbox relay (optional)
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_LEASE_SECONDS=60
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=300

# 安全
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BROWSER_AUTH_COOKIE_NAME=star_warehouse_session
# Plain-HTTP local development only. Production must set this to true (the code default is true).
BROWSER_AUTH_COOKIE_SECURE=false
BROWSER_AUTH_COOKIE_SAMESITE=lax
BROWSER_POST_LOGIN_REDIRECT_PATH=/app
JWT_ISSUER=star-warehouse-ai
JWT_AUDIENCE=star-warehouse-api

# OpenAPI docs (set to False in production)
ENABLE_OPENAPI_DOCS=True

# CORS (JSON array format required by Pydantic Settings v2)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# WebSocket（可选，不填时使用默认值）
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_RECONNECT_TIMEOUT=60

# 轮询配置（可选，不填时使用默认值）
STATUS_POLLING_INTERVAL=3

# 退款规则与风控阈值（可选，不填时使用默认值）
HIGH_RISK_REFUND_AMOUNT=2000.0
MEDIUM_RISK_REFUND_AMOUNT=500.0
REFUND_DEADLINE_DAYS=7
NON_REFUNDABLE_CATEGORIES=["内衣","食品","定制商品"]

# 情感信号词列表（可选，不填时使用默认值）
NEGATIVE_WORDS=["生气","愤怒","不满","投诉","差评","退款","骗子","垃圾","太差","失望","欺骗","坑","忽悠","恶劣","糟糕","气愤","恼火","心烦"]
URGENT_WORDS=["马上","立刻","现在","急","紧急","hurry","urgent","asap","立即","赶紧","赶快","快点","等着","急用"]
POSITIVE_WORDS=["谢谢","感谢","满意","好评","不错","好用","推荐","喜欢","完美","优秀","棒","赞","给力","靠谱"]

# Graph 路由限制（可选，不填时使用默认值）
MAX_ROUTER_ITERATIONS=5
MAX_EVALUATOR_RETRIES=3
CONFIDENCE_RETRY_THRESHOLD=0.3

# 意图分类阈值（可选，不填时使用默认值）
FUNCTION_CALLING_THRESHOLD=0.7

# 记忆保留（可选，不填时使用默认值）
MEMORY_RETENTION_DAYS=90
RETENTION_EXECUTION_ENABLED=true
RETENTION_BATCH_LIMIT=100
RETENTION_TENANT_BATCH_LIMIT=100
MEMORY_CONTEXT_TOKEN_BUDGET=2048
HISTORY_CONTEXT_TOKEN_BUDGET=1024
COMPACTION_THRESHOLD=0.75
VECTOR_MEMORY_SCORE_THRESHOLD=0.5
OBSERVATION_MASKING_MAX_CHARS=500
AGENT_CONFIG_CACHE_TTL=60
CHAT_STREAM_TIMEOUT_SECONDS=45.0
CHECKPOINT_SCHEMA_VERSION=v3.1

# SMTP / 告警通知（可选，不填时使用默认值）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
ALERT_EMAIL_FROM=alerts@example.com
ALERT_ADMIN_EMAILS=["oncall@example.com"]
PAGERDUTY_INTEGRATION_KEY=
ALERT_CSAT_THRESHOLD=0.7
ALERT_COMPLAINT_WINDOW_HOURS=24
ALERT_COMPLAINT_MAX=10

# 仪表盘告警阈值（可选，不填时使用默认值）
ALERT_TRANSFER_RATE_THRESHOLD=0.3
ALERT_CONFIDENCE_THRESHOLD=0.6
ALERT_LATENCY_MS_THRESHOLD=5000.0
SERVICE_HEALTH_URL=http://localhost:8000/health

# 上传目录与可观测性（可选，不填时使用默认值）
KNOWLEDGE_UPLOAD_DIR=uploads/knowledge
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_FORMAT=text

# Prometheus metrics export integration
PROMETHEUS_ENABLED=False
PROMETHEUS_URL=http://localhost:9090
TEMPO_URL=http://localhost:3200
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000
SLACK_WEBHOOK_URL=

# Alertmanager webhook receiver URL
ALERT_WEBHOOK_URL=
